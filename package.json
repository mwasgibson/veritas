{
  "name": "veritas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Local-first private semantic search engine — zero cloud AI, client-side embeddings, AES-256-GCM, IndexedDB",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "echo \"Unit tests: run via src/lib/tests.ts in-browser or add Vitest in Phase 8\" && exit 0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
