{
  "manifest_version": 3,
  "name": "Veritas Private Search",
  "version": "0.3.0",
  "description": "Route address-bar searches to your local Veritas index first. Query text only — no vault content leaves the device via this extension.",
  "permissions": ["omnibox", "storage", "tabs"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "v"
  },
  "action": {
    "default_title": "Veritas — open local search",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
