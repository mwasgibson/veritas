{
  "manifest_version": 3,
  "name": "Veritas Private Search",
  "version": "0.3.0",
  "description": "Route address-bar searches to your local Veritas index first.",
  "browser_specific_settings": {
    "gecko": {
      "id": "veritas-search@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["omnibox", "storage", "tabs"],
  "background": {
    "scripts": ["background.js"]
  },
  "omnibox": {
    "keyword": "v"
  },
  "action": {
    "default_title": "Veritas — open local search",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
